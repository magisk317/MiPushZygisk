#!/system/bin/sh

CONFIG_DIR=/data/adb/mipush_zygisk
CONFIG=$CONFIG_DIR/app.conf
MAX_SCAN=512

die() { echo "mipushctl: $*" >&2; exit 1; }
ensure() { [ -f "$CONFIG" ] || die "configuration is missing: $CONFIG"; }
valid_pkg() {
    # Keep CLI validation limited to package syntax; native Zygisk accepts
    # explicitly configured vendor packages as well.
    echo "$1" | grep -Eq '^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z0-9_]+)+$'
}

set_meta() {
    key=$1 value=$2 tmp=$CONFIG_DIR/app.conf.tmp.$$
    ensure
    grep -v "^${key}=" "$CONFIG" > "$tmp" || true
    printf '%s=%s\n' "$key" "$value" >> "$tmp"
    chmod 600 "$tmp" && mv "$tmp" "$CONFIG"
}

rule() {
    prefix=$1 entry=$2
    ensure
    # Replace both forms so enabling a package also removes an older deny rule.
    awk -v entry="$entry" '$0 != entry && $0 != "-" entry {print}' \
        "$CONFIG" > "$CONFIG_DIR/app.conf.tmp.$$"
    printf '%s%s\n' "$prefix" "$entry" >> "$CONFIG_DIR/app.conf.tmp.$$"
    chmod 600 "$CONFIG_DIR/app.conf.tmp.$$" && mv "$CONFIG_DIR/app.conf.tmp.$$" "$CONFIG"
}

scan() {
    ensure
    command -v dumpsys >/dev/null 2>&1 || die "dumpsys unavailable"
    count=0
    # Keep the loop in this shell; a piped while loop runs in a child shell on
    # Android and would make MAX_SCAN ineffective.
    for pkg in $(pm list packages 2>/dev/null | sed 's/^package://'); do
        [ "$count" -lt "$MAX_SCAN" ] || break
        valid_pkg "$pkg" || continue
        if dumpsys package "$pkg" 2>/dev/null | grep -Eq 'com.xiaomi.push.service|XMPushService'; then
            echo "$pkg"
        fi
        count=$((count + 1))
    done
}

case "${1:-}" in
    list|apps) ensure; sed -n '/^[A-Za-z]/p' "$CONFIG";;
    app|app-status) pkg=${2:-}; valid_pkg "$pkg" || die "invalid package"; grep -F -x "$pkg" "$CONFIG" >/dev/null && echo enabled || echo disabled;;
    enable) pkg=${2:-}; valid_pkg "$pkg" || die "invalid package"; rule '' "$pkg"; echo "enabled $pkg";;
    disable) pkg=${2:-}; valid_pkg "$pkg" || die "invalid package"; rule '-' "$pkg"; echo "denied $pkg";;
    profile) case "${2:-}" in miui14|os4) set_meta profile "$2"; echo "profile=$2";; *) echo "miui14 os4"; exit 1;; esac;;
    observe) set_meta observe "${2:-true}"; echo "observe=${2:-true}";;
    scan) scan;;
    *) echo "usage: mipushctl {list|apps|app PKG|enable PKG|disable PKG|profile [miui14|os4]|observe [true|false]|scan}" >&2; exit 2;;
esac
